# Template only -- copy to .env (or set these in your process/deployment environment)
# and fill in real values as needed. Do NOT commit a real .env with secrets.

# Optional. Overrides where main.py looks for the CosIng Annex II/III .xls files used
# for the prohibited/restricted-substance safety checks. If unset, defaults to the
# repo-relative path: ml_service/../../v2_as_ML_finalproject/dataset_for_v2
# COSING_DATA_DIR=

# Optional. Comma-separated list of origins allowed to call this API (CORS). If unset,
# defaults to "http://localhost:3005" (the Next.js frontend's dev port).
# ALLOWED_ORIGINS=http://localhost:3005

# NOTE: There is no server-side Gemini API key env var for this service. The
# `gemini_api_key` used by POST /api/ml/analyze-unknown-ingredient is passed in
# per-request by the Next.js frontend, which is responsible for resolving whether to
# use the end user's own BYOK key or a project default key before calling this
# endpoint. This service does not read or store a Gemini key itself.
